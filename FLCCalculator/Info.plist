<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AMO CRM Token</key>
	<string>$(AMOCRM_TOKEN)</string>
	<key>App Store Review Code</key>
	<string>$(APP_STORE_REVIEW_CODE)</string>
	<key>App Store Review Phone</key>
	<string>$(APP_STORE_REVIEW_PHONE)</string>
