    "Включены все операции по загрузке и выгрузке Вашего груза от склада отправления до склада назначения" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Includes all loading and unloading operations from departure warehouse to destination warehouse"
